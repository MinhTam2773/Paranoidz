{
  "name": "@paranoidz/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./client": "./src/client.ts",
    "./server": "./src/server.ts",
    "./admin": "./src/admin.ts",
    "./proxy": "./src/proxy.ts",
    "./public": "./src/public.ts",
    "./testing": "./src/testing.ts",
    "./types": "./src/types.ts",
    "./provinces": "./src/provinces.ts",
    "./thumbs": "./src/thumbs.ts",
    "./spx": "./src/spx/client.ts",
    "./spx/order-body": "./src/spx/order-body.ts",
    "./spx/sign": "./src/spx/sign.ts",
    "./spx/webhook": "./src/spx/webhook.ts"
  },
  "scripts": {
    "gen:types": "supabase gen types typescript --linked --schema public > src/types.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/**/*.test.ts\"",
    "smoke": "node --env-file=../../apps/admin/.env.local scripts/smoke-test.ts",
    "smoke:inventory": "node --env-file=../../apps/admin/.env.local scripts/inventory-smoke.ts",
    "seed:images": "node --env-file=../../apps/admin/.env.local scripts/upload-dev-images.ts",
    "seed:spx-locations": "node --env-file=../../apps/admin/.env.local scripts/spx-locations.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.1",
    "server-only": "^0.0.1"
  },
  "peerDependencies": {
    "next": ">=16"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "next": "16.2.10",
    "typescript": "^5.9.3"
  }
}
