# Copy to .env.local. Values: Supabase dashboard → Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server-only (order route → place_order). API Keys → secret. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
# Server-only: order emails (lib/order-email). Resend → API Keys, sending access, domain paranoidz.vn.
RESEND_API_KEY=re_...
# Shop mailbox: gets the new-order alert and customers' replies. Unset = no alert sent.
ORDER_ALERT_EMAIL=
# Server-only: new-order alert to the client's Zalo (lib/order-zalo). Zalo app → OA "Zalo Bot Manager" →
# Tạo bot; the token arrives by Zalo message. Chat id: the client messages the bot once, then
# POST https://bot-api.zaloplatforms.com/bot<token>/getUpdates. Either unset = no alert.
ZALO_BOT_TOKEN=
ZALO_OWNER_CHAT_ID=
# Server-only: each order's Purchase to Meta's Conversions API (lib/meta-capi). Events Manager → pixel
# 1535409166877970 → Settings → Conversions API → Generate access token. Vercel PRODUCTION only, so
# test orders never reach the pixel. Unset = not sent (the browser pixel still fires).
META_CAPI_TOKEN=
# Test environments only (local dev, Vercel Preview → test database): prefixes order emails and
# Zalo alerts with "[<value>] ". Leave unset in production.
TEST_LABEL=
# Test environments only: where links in order emails / Zalo alerts point. Unset = paranoidz.vn / admin.paranoidz.vn.
SITE_URL=
ADMIN_URL=

# SPX Open API — live shipping fee at checkout (ARCHITECTURE.md §5 "SPX Open API"). Server-only —
# never NEXT_PUBLIC_. Same values as the admin's. Unset → checkout uses the shipping_fee() table.
SPX_API_HOST=
SPX_APP_ID=
SPX_APP_SECRET=
SPX_USER_ID=
SPX_USER_SECRET=
# Where parcels are picked up (SPX province / ward names)
SPX_SENDER_WARD=
SPX_SENDER_PROVINCE=
