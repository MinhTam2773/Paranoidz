// Cloudflare Workers config for admin.paranoidz.vn (OpenNext adapter, `pnpm --filter admin cf:deploy`).
// Every page is dynamic, so no ISR cache bindings. Env vars and secrets live in the dashboard
// (Workers → paranoidz-admin → Settings), NEXT_PUBLIC_* also as build variables: they are inlined.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "paranoidz-admin",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "paranoidz-admin" }],
  // Run next to Supabase (Singapore) instead of the visitor's edge: each page makes several queries.
  "placement": { "mode": "smart" },
  "observability": { "enabled": true },
}
