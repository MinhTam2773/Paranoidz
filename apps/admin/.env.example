# Copy to .env.local. Values: Supabase dashboard → Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Secret — bypasses RLS. Admin app only; never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# SPX Open API (ARCHITECTURE.md §5 "SPX Open API"). Server-only — never NEXT_PUBLIC_.
# Test host https://test-stable.spx.vn/ · production https://spx.vn/
SPX_API_HOST=
SPX_APP_ID=
SPX_APP_SECRET=
SPX_USER_ID=
SPX_USER_SECRET=
# Pickup / sender for SPX shipments
SPX_SENDER_NAME=
SPX_SENDER_PHONE=
SPX_SENDER_EMAIL=
SPX_SENDER_ADDRESS=
SPX_SENDER_WARD=
SPX_SENDER_PROVINCE=

# Error tracking (TODO.md Now #9). Sentry → project (Next.js) → Settings → Client Keys (DSN). Unset = off.
NEXT_PUBLIC_SENTRY_DSN=
