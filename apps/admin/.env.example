# Copy to .env.local. Values: Supabase dashboard → Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Secret — bypasses RLS. Admin app only; never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# SPX Open API (ARCHITECTURE.md §5 "SPX Open API"). Server-only — never NEXT_PUBLIC_.
# Test host https://test-stable.spx.vn/ · production https://spx.vn/
SPX_API_HOST=
SPX_APP_ID=
SPX_APP_SECRET=
SPX_USER_ID=
SPX_USER_SECRET=
# Pickup / sender for SPX shipments
SPX_SENDER_NAME=
SPX_SENDER_PHONE=
SPX_SENDER_EMAIL=
SPX_SENDER_ADDRESS=
SPX_SENDER_WARD=
SPX_SENDER_PROVINCE=

# Error tracking (TODO.md Now #9). Sentry → project (Next.js) → Settings → Client Keys (DSN). Unset = off.
NEXT_PUBLIC_SENTRY_DSN=

# Media on Cloudflare R2 (@paranoidz/db/media). Production only: leave empty locally and on
# previews to keep using Supabase Storage. R2 API token: Object Read & Write on paranoidz-media.
NEXT_PUBLIC_MEDIA_URL=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Tells the storefront to re-render its cached pages after a save (lib/storefront.ts). Vercel
# PRODUCTION only, same value as the storefront's. Unset (local, previews) = not sent.
REVALIDATE_SECRET=
